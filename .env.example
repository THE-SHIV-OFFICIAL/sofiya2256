# ==================== BOT CONFIG ====================
BOT_TOKEN=
BOT_USERNAME=HINATA_GROUP_CHAT_bot
BOT_NAME=Sofiya

# ==================== NVIDIA AI (chatbot + moderation) ====================
# Get keys from https://build.nvidia.com  (extra keys = auto failover)
NVIDIA_API_KEY=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
# Optional overrides
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_FAST_MODEL=nvidia/nemotron-3-nano-30b-a3b

# ==================== MONGODB ====================
MONGO_URI=

# ==================== ADMIN ====================
OWNER_ID=8441236350
SUDO_USERS=8441236350,7553434931
LOGGER_GROUP_ID=

# ==================== MISC ====================
LOG_LEVEL=info
PING_IMAGE_URL=https://files.catbox.moe/yt6gy9.png
PORT=3000

# ==================== PREMIUM TELEGRAM EMOJI ====================
# Telegram needs custom-emoji IDs; addemoji pack links are catalogued in code.
# Format: alias=id,alias=id
PREMIUM_EMOJI_IDS=

# ==================== CHATBOT STICKERS ====================
# Optional. The bot sends stickers along with text replies, matched to the
# mood of the chat (like a real person does).
#
# Easiest way — just give sticker pack names. The bot loads every sticker
# from the packs itself and picks the right one by mood automatically.
# Pack name = the part after t.me/addstickers/ in the pack link.
# Example:
# Aapke packs (t.me/addstickers/<name>) — already set below:
STICKER_PACKS=Nishu62,Webp_19,architecture_a_r_t7,funny_cute_cats,abhaysingh1,PeachAndGomaSummer,ar3065_by_fStikBot,Aesthetic_mehh

# Optional manual override — specific sticker file_ids per mood.
# Format: mood=file_id pairs, comma separated.
# Moods: love, sad, fun, angry, sleep, hi, chatbot (chatbot = default pool).
# Get a file_id by sending the sticker to @RawDataBot and copying "file_id".
# STICKER_IDS=love=CAACAgQAAxkBAA...,fun=CAACAgUAAxkBAA...
STICKER_IDS=
AI_GAMES_ENABLED=true
